# 国内/弱网环境构建：保留国内 PyPI 镜像源，仍消费 uv.lock（导出 pinned+hash 需求后安装）。
FROM python:3.12.15-slim

# uv 工具版本与 uv.lock 的解析器保持一致（见 uv.lock revision）。
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

ARG PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

# `uv export --locked` 从锁导出全部依赖（含 httpx / python-multipart / redis extra），
# 再经国内镜像按锁内版本与 hash 安装；不重新解析。
RUN uv export --locked --no-dev --extra redis --no-emit-project -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
        --index-url "${PIP_INDEX}" --allow-insecure-host "${PIP_TRUSTED_HOST}" \
    && rm -f /tmp/requirements.txt

VOLUME ["/app/data"]
ENV DB_PATH=/app/data/stats.db \
    HOST=0.0.0.0 \
    PORT=8099

EXPOSE 8099

CMD ["python", "-m", "pallas_community_stats"]
