# 监听
HOST=0.0.0.0
PORT=8099

# SQLite 路径（目录会自动创建）
DB_PATH=data/stats.db

# 心跳鉴权：留空=公开写入（配合下方限流）；非空则须 Bearer，适合私有部署
HEARTBEAT_TOKEN=

# 公开写入时限流（仅 HEARTBEAT_TOKEN 为空时生效）
HEARTBEAT_RATE_PER_IP_PER_MIN=60
HEARTBEAT_MIN_INTERVAL_SEC=30

# 超过该秒数未心跳则不计入 deployments_online（默认 900 = 15 分钟）
ONLINE_TTL_SEC=900

# 拒绝时间戳与服务器相差超过该秒数的心跳（默认 300）
MAX_CLOCK_SKEW_SEC=300
