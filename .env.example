# 遗留示例：新部署请改用 config/stats.toml（见 config/stats.example.toml）。
# stats.toml 优先级高于本文件。

HOST=0.0.0.0
PORT=8099
DB_PATH=data/stats.db
HEARTBEAT_TOKEN=
HEARTBEAT_RATE_PER_IP_PER_MIN=60
HEARTBEAT_MIN_INTERVAL_SEC=30
ONLINE_TTL_SEC=900
MAX_CLOCK_SKEW_SEC=300

# 多实例可选（也可写在 stats.toml [env]）
